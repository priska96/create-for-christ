{
  "name": "@create-for-christ/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:migrate": "tsx src/migrate.ts",
    "test:integration": "tsx --test test/auth.integration.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.3",
    "@create-for-christ/contracts": "0.1.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "better-auth": "^1.7.3",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.16.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0"
  }
}
